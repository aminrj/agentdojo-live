# ---- Application ----
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=3000
PUBLIC_BACKEND_URL=http://localhost:8000

# ---- LLM ----
# mock   — deterministic fake provider. No GPU, no network. Used by the tests
#          and CI. Production startup refuses to boot with this set.
# ollama — a local Ollama daemon (>= 0.3) over its OpenAI-compatible API.
# openai — ANY OpenAI-compatible endpoint: OpenAI, Groq, Together, DeepInfra,
#          OpenRouter, vLLM, LiteLLM. Set LLM_BASE_URL/LLM_API_KEY/LLM_MODEL.
LLM_PROVIDER=mock

# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Pin an exact model+version so published payloads on the wall of solves
# remain reproducible. A silent model swap breaks every payload.
# Confirmed solvable on: qwen3:8b (Ollama 0.9.x)
OLLAMA_MODEL=qwen3:8b

# qwen3:8b is a *thinking* model. With reasoning on it spends the token budget
# on a <think> trace and often never emits the tool call, so the tool-driven
# missions (03, 04) silently fail to resolve. We send Ollama a top-level
# `think: false` by default so tool calls land within LLM_MAX_TOKENS. Set false
# to attack the model in full thinking mode (raise LLM_MAX_TOKENS if you do).
OLLAMA_DISABLE_THINKING=true

# Used when LLM_PROVIDER=openai. Same pinning rule: name an exact model, never
# a floating alias like "-latest".
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional label shown in the UI. Defaults to the resolved model name.
LLM_DISPLAY_NAME=

# ---- Postgres (dormant in v1) ----
# Set USE_POSTGRES=true and start the postgres profile to re-enable.
# v1 default: Redis only. All solve tracking lives in Redis.
USE_POSTGRES=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdojo
POSTGRES_USER=agentdojo
POSTGRES_PASSWORD=agentdojo

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Rate limiting & abuse control ----
RATE_LIMIT_PER_HOUR=50

# Header carrying the real client IP, set by a proxy you trust to OVERWRITE it.
# Empty = trust nothing, use the socket peer (correct for local development).
# Behind Cloudflare: cf-connecting-ip.
#
# Never set this to x-forwarded-for on a public deployment. XFF is
# client-supplied, so trusting it lets anyone mint a fresh rate-limit bucket
# per request. Production startup rejects that value outright.
TRUSTED_CLIENT_IP_HEADER=

# Global concurrency cap: max simultaneous LLM inferences.
# ~3 for a single homelab GPU; much higher for a hosted API.
MAX_CONCURRENT_LLM=3

# Hard ceiling on total LLM calls per UTC day, across all visitors. 0 = off.
# Per-IP limits bound one visitor; they do not bound the bill, because the
# endpoint is unauthenticated and you do not control how many IPs show up.
# Set this to something you would be relaxed about paying for twice.
DAILY_LLM_CALL_CAP=0

# Set false to park the agent without taking the site down. Missions, the wall
# and the write-ups keep serving. There is also a runtime switch in Redis:
#   redis-cli SET llm:disabled 1     /     redis-cli DEL llm:disabled
LLM_ENABLED=true

# ---- Exfil listener ----
EXFIL_LISTENER_URL=http://backend:8000/api/exfil/ingest
# Gates the canary ingestion endpoint. Left at the default, anyone could forge
# a solve. Production startup refuses to boot on this value.
#   generate with:  openssl rand -hex 32
EXFIL_LISTENER_TOKEN=change-me-in-prod

# ---- Public deployment (docker-compose.prod.yml) ----
# The hostname the tunnel serves. Used for CORS and the public backend URL.
PUBLIC_HOSTNAME=
# Token from: Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Hints ----
HINT_1_AFTER_TURNS=5
HINT_2_AFTER_TURNS=10

# ---- Observability ----
LOG_LEVEL=INFO
