# ---- Application ----
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=3000
PUBLIC_BACKEND_URL=http://localhost:8000

# ---- LLM ----
# `mock` uses a deterministic fake provider (no GPU needed, used in tests).
# `ollama` uses an OpenAI-compatible endpoint (Ollama >= 0.3).
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdojo
POSTGRES_USER=agentdojo
POSTGRES_PASSWORD=agentdojo

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Rate limiting ----
RATE_LIMIT_PER_HOUR=50

# ---- Exfil listener ----
EXFIL_LISTENER_URL=http://backend:8000/api/exfil/ingest
EXFIL_LISTENER_TOKEN=change-me-in-prod

# ---- Hints ----
HINT_1_AFTER_TURNS=5
HINT_2_AFTER_TURNS=10

# ---- Observability ----
LOG_LEVEL=INFO
